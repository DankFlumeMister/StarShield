/*
 * StarShield 键位映射（自动生成，请勿手改）
 *
 * 生成脚本：docs/_tools/gen_keymap.mjs
 * 位置号 = 物理顺序（0 = 键盘左上角 Esc），与 starshield_transform.dtsi 严格对应。
 * 键位布局与几何见 docs/matrix-assignment.md；本文件每层必须恰好 95 条绑定。
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/reset.h>

#define FN 1

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
                /* ----- F 行（位置 0 起）----- */
                &kp ESC              &mo FN               &kp KP_NUM           &kp F1               &kp F2               &kp F3              /*  0- 5  Esc FN NumLock F1 F2 F3 */
                &kp F4               &kp F5               &kp F6               &kp F7               &kp F8               &kp F9              /*  6-11  F4 F5 F6 F7 F8 F9 */
                /* ----- 小键盘/导航（位置 16 起）----- */
                &kp F10              &kp F11              &kp F12              &kp DEL              &kp KP_SLASH         &kp KP_ASTERISK     /* 12-17  F10 F11 F12 Del KP / KP * */
                /* ----- 数字行（位置 20 起）----- */
                &kp KP_MINUS         &kp KP_PLUS          &kp GRAVE            &kp N1               &kp N2               &kp N3              /* 18-23  KP - KP + `~ 1! 2@ 3# */
                &kp N4               &kp N5               &kp N6               &kp N7               &kp N8               &kp N9              /* 24-29  4$ 5% 6^ 7& 8* 9( */
                &kp N0               &kp MINUS            &kp EQUAL            &kp BSPC             &kp KP_NUM           &kp KP_N7           /* 30-35  0) -_ =+ Bksp KP Del KP 7 */
                /* ----- Q 行（位置 38 起）----- */
                &kp KP_N8            &kp KP_N9            &kp TAB              &kp Q                &kp W                &kp E               /* 36-41  KP 8 KP 9 Tab Q W E */
                &kp R                &kp T                &kp Y                &kp U                &kp I                &kp O               /* 42-47  R T Y U I O */
                &kp P                &kp LBKT             &kp RBKT             &kp RET              &kp KP_N4            &kp KP_N5           /* 48-53  P [{ ]} Enter KP 4 KP 5 */
                /* ----- A 行（位置 55 起）----- */
                &kp KP_N6            &kp CLCK             &kp A                &kp S                &kp D                &kp F               /* 54-59  KP 6 Caps A S D F */
                &kp G                &kp H                &kp J                &kp K                &kp L                &kp SEMI            /* 60-65  G H J K L ;: */
                /* ----- Z 行（位置 71 起）----- */
                &kp SQT              &kp KP_ENTER         &kp KP_N1            &kp KP_N2            &kp KP_N3            &kp LSHFT           /* 66-71  '" KP Ent KP 1 KP 2 KP 3 LShift */
                &kp Z                &kp X                &kp C                &kp V                &kp B                &kp N               /* 72-77  Z X C V B N */
                &kp M                &kp COMMA            &kp DOT              &kp FSLH             &kp UP               &kp RSHFT           /* 78-83  M ,< .> /? Up RShift */
                /* ----- 底行（位置 86 起）----- */
                &kp KP_N0            &kp KP_DOT           &kp LCTRL            &kp LGUI             &kp LALT             &kp SPACE           /* 84-89  KP 0 KP . LCtrl LWin LAlt Space */
                &kp BSLH             &kp LEFT             &kp DOWN             &kp RIGHT            &kp RCTRL           /* 90-94  \| Left Down Right RCtrl */
            >;
        };

        fn_layer {
            display-name = "FN";
            bindings = <
                /* ----- F 行（位置 0 起）----- */
                &kp ESC              &mo FN               &kp KP_NUM           &kp C_BRI_DN         &kp C_BRI_UP         &kp C_MUTE          /*  0- 5  Esc FN NumLock F1 F2 F3 */
                &kp C_VOL_DN         &kp C_VOL_UP         &kp C_PREV           &kp C_PLAY_PAUSE     &kp C_NEXT           &rgb_ug RGB_TOG     /*  6-11  F4 F5 F6 F7 F8 F9 */
                /* ----- 小键盘/导航（位置 16 起）----- */
                &rgb_ug RGB_BRD      &rgb_ug RGB_BRI      &rgb_ug RGB_EFF      &kp DEL              &kp K_CMENU          &kp KP_NUM          /* 12-17  F10 F11 F12 Del KP / KP * */
                /* ----- 数字行（位置 20 起）----- */
                &kp K_CMENU          &kp KP_NUM           &kp GRAVE            &kp F1               &kp F2               &kp F3              /* 18-23  KP - KP + `~ 1! 2@ 3# */
                &kp F4               &kp F5               &kp F6               &kp F7               &kp F8               &kp F9              /* 24-29  4$ 5% 6^ 7& 8* 9( */
                &kp F10              &kp F11              &kp F12              &kp BSPC             &kp K_CMENU          &kp HOME            /* 30-35  0) -_ =+ Bksp KP Del KP 7 */
                /* ----- Q 行（位置 38 起）----- */
                &kp UP               &kp PG_UP            &kp TAB              &kp Q                &kp W                &kp E               /* 36-41  KP 8 KP 9 Tab Q W E */
                &kp R                &kp T                &kp Y                &kp U                &kp I                &kp O               /* 42-47  R T Y U I O */
                &kp P                &kp LBKT             &kp RBKT             &kp RET              &kp LEFT             &kp KP_N5           /* 48-53  P [{ ]} Enter KP 4 KP 5 */
                /* ----- A 行（位置 55 起）----- */
                &kp RIGHT            &kp CLCK             &kp A                &kp S                &kp D                &kp F               /* 54-59  KP 6 Caps A S D F */
                &kp G                &kp H                &kp J                &kp K                &kp L                &kp SEMI            /* 60-65  G H J K L ;: */
                /* ----- Z 行（位置 71 起）----- */
                &kp SQT              &kp K_CMENU          &kp END              &kp DOWN             &kp PG_DN            &kp LSHFT           /* 66-71  '" KP Ent KP 1 KP 2 KP 3 LShift */
                &kp Z                &kp X                &kp C                &kp V                &kp B                &kp N               /* 72-77  Z X C V B N */
                &kp M                &kp COMMA            &kp DOT              &kp FSLH             &kp UP               &kp RSHFT           /* 78-83  M ,< .> /? Up RShift */
                /* ----- 底行（位置 86 起）----- */
                &kp INS              &kp DEL              &kp LCTRL            &kp LGUI             &kp LALT             &kp SPACE           /* 84-89  KP 0 KP . LCtrl LWin LAlt Space */
                &kp BSLH             &kp LEFT             &kp DOWN             &kp RIGHT            &kp RCTRL           /* 90-94  \| Left Down Right RCtrl */
            >;
        };
    };
};
