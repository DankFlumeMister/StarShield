&physical_layout0 {
    transform = <&default_transform>;
};

/ {
    /*
     * 矩阵转换表：位置号 -> 矩阵格 (行, 列)。
     * 宏 RC(row, col) 来自 <dt-bindings/zmk/matrix_transform.h>。
     *
     * ⚠️ 必须用「节点定义」形式（label: node { ... }）而不是 &label { ... }：
     *    后者是 fragment 覆写，对【尚未定义】的新标签无效。
     */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <18>;
        rows = <6>;
        map = <
            RC(0, 0)  RC(0, 1)  RC(0, 2)  RC(0, 3)  RC(0, 4)  RC(0, 5)   /*  0- 5  Esc | FN | Num Lock | F1 | F2 | F3 */
            RC(0, 6)  RC(0, 7)  RC(0, 8)  RC(0, 9)  RC(0,10)  RC(0,11)   /*  6-11  F4 | F5 | F6 | F7 | F8 | F9 */
            RC(0,12)  RC(0,13)  RC(0,14)  RC(0,15)  RC(1, 0)  RC(1, 1)   /* 12-17  F10 | F11 | F12 | Delete | / | * */
            RC(1, 2)  RC(1, 3)  RC(1, 4)  RC(1, 5)  RC(1, 6)  RC(1, 7)   /* 18-23  - | + | ~/` | !/1 | @/2 | #/3 */
            RC(1, 8)  RC(1, 9)  RC(1,10)  RC(1,11)  RC(1,12)  RC(1,13)   /* 24-29  $/4 | %/5 | ^/6 | &/7 | * /8 | (/9 */
            RC(1,14)  RC(1,15)  RC(1,16)  RC(1,17)  RC(2, 0)  RC(2, 1)   /* 30-35  )/0 | _/- | +/= | Back Space | Delete | 7/Home */
            RC(2, 2)  RC(2, 3)  RC(2, 4)  RC(2, 5)  RC(2, 6)  RC(2, 7)   /* 36-41  8/↑ | 9/PgUp | Tab | Q | W | E */
            RC(2, 8)  RC(2, 9)  RC(2,10)  RC(2,11)  RC(2,12)  RC(2,13)   /* 42-47  R | T | Y | U | I | O */
            RC(2,14)  RC(2,15)  RC(2,16)  RC(2,17)  RC(3, 0)  RC(3, 1)   /* 48-53  P | {/[ | }/] | Enter | 4/← | 5 */
            RC(3, 2)  RC(3, 3)  RC(3, 4)  RC(3, 5)  RC(3, 6)  RC(3, 7)   /* 54-59  6/→ | Caps Lock | A | S | D | F */
            RC(3, 8)  RC(3, 9)  RC(3,10)  RC(3,11)  RC(3,12)  RC(3,13)   /* 60-65  G | H | J | K | L | :/; */
            RC(3,14)  RC(4, 0)  RC(4, 1)  RC(4, 2)  RC(4, 3)  RC(4, 4)   /* 66-71  "/' | Enter | 1/End | 2/↓ | 3/PgDn | Shift */
            RC(4, 5)  RC(4, 6)  RC(4, 7)  RC(4, 8)  RC(4, 9)  RC(4,10)   /* 72-77  Z | X | C | V | B | N */
            RC(4,11)  RC(4,12)  RC(4,13)  RC(4,14)  RC(4,15)  RC(4,16)   /* 78-83  M | </, | >/. | ?// | ↑ | Shift */
            RC(5, 0)  RC(5, 1)  RC(5, 2)  RC(5, 3)  RC(5, 4)  RC(5, 5)   /* 84-89  0/Ins | ./Del | Ctrl | Win | Alt | Space */
            RC(5, 6)  RC(5, 7)  RC(5, 8)  RC(5, 9)  RC(5,10)   /* 90-94  |/\ | ← | ↓ | → | Ctrl */
        >;
    };
};

