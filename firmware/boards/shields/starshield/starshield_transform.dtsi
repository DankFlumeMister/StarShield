/*
 * StarShield 键位映射表 + 物理布局（自动生成，请勿手改）
 *
 * 生成源：docs/_generated/matrix.json
 * 生成脚本：docs/_tools/gen_transform.mjs
 * 说明文档：docs/matrix-assignment.md
 *
 * 位置号按【物理顺序】排列（KLE 的 y 从上到下，同一行内按开关中心 x 从左到右），
 * 因此 keymap 里第 0 个键就是键盘左上角那个键。
 *
 * 矩阵：6 行 × 18 列，键数 95
 *
 * ⚠️ 采用 ZMK 的 physical-layout 模型（官方 physical-layouts.md）：
 *    - physical_layout0 聚合 kscan + matrix transform + 可选按键物理位置
 *    - keys 属性（centi-keyunit）是 ZMK Studio 支持所必需的
 *    旧式 chosen { zmk,matrix-transform = ... } 已不再使用。
 */

#include <physical_layouts.dtsi>
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "StarShield 95";

        /* 取 KLE 坐标 ×100 得 centi-keyunit；顺序与 keymap 绑定严格一致 */
        keys  //                  w    h     x     y   rot  rx  ry
            = <&key_physical_attrs 100 100   25    0     0   0   0>   /*  0 Esc */
