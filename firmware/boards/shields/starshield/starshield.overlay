/*
 * StarShield — 95 键无线机械键盘，ZMK shield 配置
 *
 * 目标板：nice!nano v2（nRF52840）
 * 矩阵：6 行 × 18 列，95 键，每个键一颗 1N4148W 二极管，col2row
 * 列驱动：3 颗 74HC595 级联（ZMK 官方 zmk,gpio-595 驱动）
 *   ⚠️ 2026-09-18 修订：原「2 颗」是电气错误 —— 2 颗只有 16 个输出位，驱动不了 18 列；
 *      ngpios=24 时驱动每轮移 24 个时钟，bit16/17 被推出链尾丢失 ⇒ COL16/17（小键盘区）失灵。
 *      位序依据 gpio_595.c：bit0..7 = 第 1 颗 QA..QH、bit8..15 = 第 2 颗、bit16..23 = 第 3 颗。
 * RGB：95 颗 SK6812MINI-E，数据链首颗数据线走 spi3（ZMK 官方做法）
 *
 * ⚠️ 引脚分配依据（见 docs/matrix-folding-analysis.md §4 与 docs/power-architecture.md）：
 *   - 官方要求：移位寄存器只能当【输出】，MCU【输入】脚必须直连
 *     （为保留按键唤醒中断）→ col2row 下【列走 595、行直连 MCU】
 *   - 官方要求：595 的 ngpios 只能取 8/16/24/32 → 18 列需 **3 颗**级联（24 位链、用前 18 位）
 *   - 595 与 WS2812 必须用【不同】SPI 外设（两者都是 SPI 从设备）
 *       595   → &spi1（MOSI P0.10 / SCK P1.13；**MISO 已在本 shield 覆盖掉** ——
 *               板级默认把 MISO 放在 P1.11 = D14，与 C1 的三档开关 MODE1 冲突，见下方 &pinctrl）
 *       WS2812 → &spi3（MOSI P0.06）
 *   - P0.13 是 nice!nano 的 VCC 门控脚（置高切断 VCC），官方就是这么省 LED 静态功耗的
 *   - 三档模式开关（C1）：D2(P0.17) / D14(P1.11) / D18(P1.15) = MODE0/MODE1/MODE2
 *
 * ⚠️ 本文件为设计稿：引脚分配已在 DTS 层面自洽，但【投板前必须用实物核对】
 *    （nice!nano 的排针 pitch/每边脚数未能从官方数字确认，仅有 Pro Micro 标准旁证）。
 */

#include <behaviors.dtsi>
#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/* 键位映射表（自动生成，内容为 &default_transform { columns/rows/map }） */
#include "starshield_transform.dtsi"

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,underglow = &led_strip;
        /* ⚠️ ZMK 已迁移到 physical-layout 模型（官方 docs/hardware-integration/physical-layouts.md）：
           旧式 `zmk,matrix-transform = &default_transform` 不再使用，
           改为指向 physical_layout0（它聚合 kscan + transform + 按键物理位置）。
           physical_layout0 与 default_transform 定义在 starshield_transform.dtsi。 */
        zmk,physical-layout = &physical_layout0;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "col2row";

        /*
         * 6 个行：直连 MCU（输入，可触发中断）。
         * 用 &pro_micro N 引用 Pro Micro 排针号，而不是裸 gpio 控制器，
         * 这样换了板子（只要兼容 Pro Micro）不用改这里。
         */
        row-gpios
            = <&pro_micro 4  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* P0.22  D4/A6 */
            , <&pro_micro 5  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* P0.24  D5    */
            , <&pro_micro 6  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* P1.00  D6/A7 */
            , <&pro_micro 7  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* P0.11  D7    */
            , <&pro_micro 9  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* P1.06  D9/A9 */
            , <&pro_micro 8  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* P1.04  D8/A8 */
            ;

        /*
         * 18 个列：全部由 3 颗级联的 74HC595 驱动（MCU 输出）。
         * ngpios = 24 → 引脚号 0..17 有效，其中 0..7 在第 1 颗、8..15 在第 2 颗、
         * 16..17 在第 3 颗的 QA/QB（第 3 颗其余输出空闲）。
         */
        col-gpios
            = <&shifter  0 GPIO_ACTIVE_HIGH>
            , <&shifter  1 GPIO_ACTIVE_HIGH>
            , <&shifter  2 GPIO_ACTIVE_HIGH>
            , <&shifter  3 GPIO_ACTIVE_HIGH>
            , <&shifter  4 GPIO_ACTIVE_HIGH>
            , <&shifter  5 GPIO_ACTIVE_HIGH>
            , <&shifter  6 GPIO_ACTIVE_HIGH>
            , <&shifter  7 GPIO_ACTIVE_HIGH>
            , <&shifter  8 GPIO_ACTIVE_HIGH>
            , <&shifter  9 GPIO_ACTIVE_HIGH>
            , <&shifter 10 GPIO_ACTIVE_HIGH>
            , <&shifter 11 GPIO_ACTIVE_HIGH>
            , <&shifter 12 GPIO_ACTIVE_HIGH>
            , <&shifter 13 GPIO_ACTIVE_HIGH>
            , <&shifter 14 GPIO_ACTIVE_HIGH>
            , <&shifter 15 GPIO_ACTIVE_HIGH>
            , <&shifter 16 GPIO_ACTIVE_HIGH>
            , <&shifter 17 GPIO_ACTIVE_HIGH>
            ;
    };

    /*
     * RGB 电源门控（ZMK ext-power）。
     *
     * ⚠️ 节点名必须是 EXT_POWER，否则用户已保存的设置会丢失（ZMK 官方文档明确要求）。
     *
     * nice!nano v2 官方用 P0.13 控制 VCC 通断，极性为 GPIO_ACTIVE_HIGH：
     *   active（高）= 打开外设电源；inactive（低）= 切断
     *
     * ⚠️ 本项目的 LED 由电池直供（ADR-0007），因此【不是】直接拿 P0.13 去开关 VCC，
     *    而是用 P0.13 驱动 §5.4 的 NMOS 反相级（2N7002 + AO3401A）。
     *    反相级之后逻辑非反相，所以这里仍然是 GPIO_ACTIVE_HIGH。
     *    （若改用直接驱动 PMOS 且带栅源上拉的拓扑，则应改为 GPIO_ACTIVE_LOW。）
     */
    EXT_POWER {
        compatible = "zmk,ext-power-generic";
        control-gpios = <&pro_micro 10 GPIO_ACTIVE_HIGH>;   /* P0.09 → 反相级 → LED 轨 */
        init-delay-ms = <50>;
    };

    /*
     * 三档模式开关（C1，ADR-0009）—— SP3T C&K PCM13（原理图位号 SW96，B4 由 SW1 改名）。
     * 原理图连接（control.kicad_sch）：公共端(3) → GND；档 0/1/4 → MODE0/MODE1/MODE2。
     *   档 0（有线）  = MODE0 = D2  (P0.17)
     *   档 1（蓝牙）  = MODE1 = D14 (P1.11)
     *   档 2（2.4G）  = MODE2 = D18 (P1.15)
     *
     * 🔴 **物理档位顺序（用户 2026-09-19 定，外壳侧壁开口、与 USB-C 同一面）**：
     *   拨片**从左往右** = **2.4G / 蓝牙 / 有线**。
     *   依据：C&K PCM 手册 SP3T 连接表 `1-3 / 2-3 / 3-4` ⇒ pin3=公共端，
     *   **POS1→pin1、POS2→pin2、POS3→pin4**；PCB 上 SW96 取 **rot=180**（柄朝后壁）
     *   会把 X 镜像 ⇒ 板坐标自左向右 = POS3/POS2/POS1 = pin4/pin2/pin1
     *   = MODE2/MODE1/MODE0 = **2.4G / 蓝牙 / 有线** ✓
     *   ⚠️ **改 SW96 的 rot 或改这三条接线都会反转顺序** —— 改之前先回看这一段的推算。
     *
     * ⚠️ DT 里【不要】写 pull 标志：驱动按 GPIO_ACTIVE_LOW 自行推导 PULL_UP
     *    （kscan_gpio_direct.c 的 kscan_gpio_get_extra_flags()；ADR-0009 已核对源码；
     *      出货产品 Altar I 写了 PULL_UP 属「冗余但无害」，本项目按官方文档不写）。
     * ⚠️ wakeup-source：拨动开关本身即可把 MCU 从深度睡眠唤醒（Altar I 同款做法）。
     *
     * ⚠️ 若 C7（ESB 端点验证）通过，「2.4G」档改由 zmk-esb-endpoint 的最后 BLE profile
     *    承载 —— 档位读取方式不变，只需换 col2 的绑定。
     */
    kscan_sp3t_toggle: kscan_sp3t_toggle {
        compatible = "zmk,kscan-gpio-direct";
        toggle-mode;
        wakeup-source;

        /* ⚠️ 这里的顺序 = 原理图 MODE0/MODE1/MODE2 的**引脚号顺序**，
           不是外壳上「从左往右」的视觉顺序。
           视觉顺序（左→右 = 2.4G / 蓝牙 / 有线）由 SW96 的 rot=180 决定，
           推算见本文件顶部的「物理档位顺序」注释。 */
        input-gpios
            = <&pro_micro 2  GPIO_ACTIVE_LOW>   /* 档 0：有线  = MODE0 = D2  (P0.17) */
            , <&pro_micro 14 GPIO_ACTIVE_LOW>   /* 档 1：蓝牙  = MODE1 = D14 (P1.11) */
            , <&pro_micro 18 GPIO_ACTIVE_LOW>   /* 档 2：2.4G  = MODE2 = D18 (P1.15) */
            ;
    };

    /*
     * 档位 → 行为映射（sideband 写法，与 keymap 解耦：用户改键 / Studio 改键都不会破坏它）。
     * 照抄上游 zmk_uno.overlay 的参考实现（ADR-0009 已逐行核对 v0.3.0）。
     */
    macros {
        mode_ble_host: mode_ble_host {
            /* 蓝牙档：切到 BLE 输出 + 配对位 0（直连主机） */
            bindings = <&out OUT_BLE &bt BT_SEL 0>;
        };

        mode_dongle: mode_dongle {
            /* 2.4G 档：切到 BLE 输出 + 配对位 1（Dongle 是 BLE HID 主机，ADR-0001） */
            bindings = <&out OUT_BLE &bt BT_SEL 1>;
        };
    };

    endpoint_sideband_behaviors {
        compatible = "zmk,kscan-sideband-behaviors";
        auto-enable;
        wakeup-source;
        kscan = <&kscan_sp3t_toggle>;

        mode_col0: mode_col0 {
            column = <0>;
            bindings = <&out OUT_USB>;          /* 有线 */
        };

        mode_col1: mode_col1 {
            column = <1>;
            bindings = <&mode_ble_host>;        /* 蓝牙 */
        };

        mode_col2: mode_col2 {
            column = <2>;
            bindings = <&mode_dongle>;          /* 2.4G（Dongle） */
        };
    };
};

/*
 * 🔴 覆盖板级 spi1 的 pinctrl：**去掉 MISO**。
 *
 * nice!nano 板级 `spi1_default` 含 `SPIM_MISO = P1.11`（= Pro Micro D14），
 * 而 C1 把 **D14 定案为三档开关的 MODE1**（B2，见 §9）⇒ 直接冲突。
 * 74HC595 是**只写**器件（SER/SRCLK/RCLK 三根线），MISO 根本不接 ⇒ 显式去掉，
 * 既释放 P1.11，又省一根引脚配置。此覆盖写在本 shield 里，换板时需同步检查。
 */
&pinctrl {
    spi1_default: spi1_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
                <NRF_PSEL(SPIM_MOSI, 0, 10)>;
        };
    };

    spi1_sleep: spi1_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
                <NRF_PSEL(SPIM_MOSI, 0, 10)>;
            low-power-enable;
        };
    };
};

/* 595 走 spi1（与 WS2812 的 spi3 分开，避免两个 SPI 从设备冲突） */
&spi1 {
    status = "okay";
    /* 片选：595 的 RCLK/锁存脚。用一个空闲的 Pro Micro 脚 */
    cs-gpios = <&pro_micro 19 GPIO_ACTIVE_LOW>;             /* P0.02  D19/A1 */

    shifter: sr595@0 {
        compatible = "zmk,gpio-595";
        status = "okay";
        gpio-controller;
        #gpio-cells = <2>;
        reg = <0>;
        spi-max-frequency = <200000>;
        ngpios = <24>;      /* 3 颗 74HC595 级联（24 位链，用前 18 位驱动 COL0..17） */
    };
};

/* WS2812 数据链走 spi3（ZMK 官方对 nRF52 的推荐做法，见官方 underglow 文档） */
&pinctrl {
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 6)>;            /* P0.06  (Pro Micro D1) */
        };
    };

    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 6)>;
            low-power-enable;
        };
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";

    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";

        reg = <0>;                      /* 必须存在，SPI 绑定要求 */
        spi-max-frequency = <4000000>;

        chain-length = <95>;            /* StarShield = 95 颗 per-key LED */
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;

        /* SK6812MINI-E 为 GRB 顺序 */
        color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
    };
};
